#!/usr/bin/env python3
"""OpenAI-compatible /v1/audio/transcriptions front-end for Volcengine (Doubao)
big-model streaming ASR.

Voxtype's `[whisper] mode = "remote"` speaks the OpenAI transcription API
(multipart upload -> {"text": ...}). Doubao ASR speaks a custom binary
WebSocket protocol. This process sits between them, so no model ever runs
locally.

Config comes from ~/.config/voxtype/doubao.env (see DEFAULTS below).
Debug a failing setup with:  voxtype-doubao-shim --selftest some.wav
"""

import gzip
import json
import os
import re
import struct
import subprocess
import sys
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

from websockets.exceptions import InvalidStatus
from websockets.sync.client import connect

# ---------------------------------------------------------------- config ----

DEFAULTS = {
    # 新版控制台：只需一个 API Key（请求头 X-Api-Key）
    "DOUBAO_API_KEY": "",
    # 旧版控制台：App ID + Access Token（请求头 X-Api-App-Key / X-Api-Access-Key）
    # 两种填一种即可；都填时优先用 API Key
    "DOUBAO_APP_ID": "",
    "DOUBAO_ACCESS_TOKEN": "",
    # 模型2.0：按时长 volc.seedasr.sauc.duration / 并发版 volc.seedasr.sauc.concurrent
    # 模型1.0：按时长 volc.bigasr.sauc.duration  / 并发版 volc.bigasr.sauc.concurrent
    "DOUBAO_RESOURCE_ID": "volc.seedasr.sauc.duration",
    # nostream = 流式输入、末包后返回，准确率高于双向流式，适合按住说话
    "DOUBAO_ENDPOINT": "wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream",
    "DOUBAO_MODEL_NAME": "bigmodel",
    "DOUBAO_UID": "voxtype",
    "DOUBAO_ENABLE_ITN": "1",   # 逆文本归一化：把"二零二五年"写成"2025年"
    "DOUBAO_ENABLE_PUNC": "1",  # 自动标点
    "DOUBAO_ENABLE_DDC": "1",   # 语义顺滑，去掉"嗯""那个"这类口水词
    "DOUBAO_TIMEOUT": "20",
    "SHIM_HOST": "127.0.0.1",
    "SHIM_PORT": "6688",
    "DOUBAO_DEBUG": "0",
}


def load_config():
    cfg = dict(DEFAULTS)
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    env_file = os.path.join(config_home, "voxtype", "doubao.env")
    if os.path.exists(env_file):
        with open(env_file, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                cfg[key.strip()] = val.strip().strip('"').strip("'")
    cfg.update({k: v for k, v in os.environ.items() if k in DEFAULTS})
    return cfg


CFG = load_config()
DEBUG = CFG["DOUBAO_DEBUG"] not in ("", "0", "false", "no")


def log(*args):
    print(*args, file=sys.stderr, flush=True)


def dbg(*args):
    if DEBUG:
        log("[debug]", *args)


# ------------------------------------------------- volcengine v3 protocol ----

PROTOCOL_VERSION = 0b0001
HEADER_SIZE = 0b0001

CLIENT_FULL_REQUEST = 0b0001
CLIENT_AUDIO_ONLY = 0b0010
SERVER_FULL_RESPONSE = 0b1001
SERVER_ACK = 0b1011
SERVER_ERROR = 0b1111

NO_SEQUENCE = 0b0000
POS_SEQUENCE = 0b0001
NEG_SEQUENCE = 0b0010
NEG_WITH_SEQUENCE = 0b0011

NO_SERIALIZATION = 0b0000
JSON_SERIALIZATION = 0b0001
NO_COMPRESSION = 0b0000
GZIP_COMPRESSION = 0b0001


def frame(msg_type, flags, payload, seq=None, serial=JSON_SERIALIZATION):
    """4-byte header [+ 4-byte sequence] + 4-byte payload size + gzip payload."""
    body = gzip.compress(payload)
    head = bytes([
        (PROTOCOL_VERSION << 4) | HEADER_SIZE,
        (msg_type << 4) | flags,
        (serial << 4) | GZIP_COMPRESSION,
        0x00,
    ])
    out = bytearray(head)
    if seq is not None:
        out += struct.pack(">i", seq)
    out += struct.pack(">I", len(body))
    out += body
    return bytes(out)


def parse_frame(data):
    """-> (msg_type, flags, payload_obj_or_bytes)"""
    header_size = data[0] & 0x0F
    msg_type = data[1] >> 4
    flags = data[1] & 0x0F
    serial = data[2] >> 4
    compression = data[2] & 0x0F
    pos = header_size * 4

    if flags & 0x01:  # carries a sequence number
        pos += 4
    code = None
    if msg_type == SERVER_ERROR:
        code = struct.unpack(">I", data[pos:pos + 4])[0]
        pos += 4

    size = struct.unpack(">I", data[pos:pos + 4])[0]
    pos += 4
    payload = data[pos:pos + size]

    if compression == GZIP_COMPRESSION and payload:
        payload = gzip.decompress(payload)
    if serial == JSON_SERIALIZATION and payload:
        payload = json.loads(payload.decode("utf-8"))
    if code is not None:
        payload = {"_error_code": code, "_error": payload}
    return msg_type, flags, payload


def build_request():
    def flag(key):
        return CFG[key] not in ("", "0", "false", "no")

    return {
        "user": {"uid": CFG["DOUBAO_UID"]},
        "audio": {
            "format": "pcm",
            "codec": "raw",
            "rate": 16000,
            "bits": 16,
            "channel": 1,
        },
        "request": {
            "model_name": CFG["DOUBAO_MODEL_NAME"],
            "enable_itn": flag("DOUBAO_ENABLE_ITN"),
            "enable_punc": flag("DOUBAO_ENABLE_PUNC"),
            "enable_ddc": flag("DOUBAO_ENABLE_DDC"),
            "show_utterances": False,
            "result_type": "full",
        },
    }


def extract_text(payload):
    """Dig the transcript out of a server response, tolerating shape changes."""
    if not isinstance(payload, dict):
        return ""
    result = payload.get("result")
    if isinstance(result, dict):
        if result.get("text"):
            return result["text"]
        utts = result.get("utterances") or []
        return "".join(u.get("text", "") for u in utts if isinstance(u, dict))
    if isinstance(result, list):
        return "".join(r.get("text", "") for r in result if isinstance(r, dict))
    return payload.get("text", "") or ""


def auth_headers():
    """New console: one API key. Old console: App ID + Access Token."""
    if CFG["DOUBAO_API_KEY"]:
        return {"X-Api-Key": CFG["DOUBAO_API_KEY"]}
    if CFG["DOUBAO_APP_ID"] and CFG["DOUBAO_ACCESS_TOKEN"]:
        return {
            "X-Api-App-Key": CFG["DOUBAO_APP_ID"],
            "X-Api-Access-Key": CFG["DOUBAO_ACCESS_TOKEN"],
        }
    raise RuntimeError(
        "未配置凭据：在 ~/.config/voxtype/doubao.env 里填 DOUBAO_API_KEY（新版控制台），"
        "或 DOUBAO_APP_ID + DOUBAO_ACCESS_TOKEN（旧版控制台）"
    )


def explain_handshake_error(exc):
    """Turn a rejected WebSocket upgrade into an actionable message."""
    resp = getattr(exc, "response", None)
    status = getattr(resp, "status_code", None)
    body = ""
    try:
        body = (resp.body or b"").decode("utf-8", "replace")[:300]
    except Exception:
        pass
    hint = ""
    if "resource" in body.lower():
        # e.g. 403 "requested resource not granted", 400 "resourceId ... is not allowed"
        hint = ("资源 ID 不可用：确认控制台已开通对应模型，且 DOUBAO_RESOURCE_ID 与之对应"
                "（模型2.0 = volc.seedasr.*，模型1.0 = volc.bigasr.*；按时长 .duration / 并发版 .concurrent）")
    elif status in (401, 403):
        hint = "凭据无效：检查 API Key / App ID / Access Token 是否抄全、是否属于同一个应用"
    return RuntimeError(f"豆包建连被拒 HTTP {status}: {body} {hint}".strip())


def transcribe(pcm: bytes) -> str:
    headers = auth_headers()
    headers.update({
        "X-Api-Resource-Id": CFG["DOUBAO_RESOURCE_ID"],
        "X-Api-Request-Id": str(uuid.uuid4()),
        "X-Api-Connect-Id": str(uuid.uuid4()),
    })
    timeout = float(CFG["DOUBAO_TIMEOUT"])
    chunk_size = 16000 * 2 // 5  # 200ms of 16k/16bit mono
    chunks = [pcm[i:i + chunk_size] for i in range(0, len(pcm), chunk_size)] or [b""]

    text = ""
    try:
        ws = connect(
            CFG["DOUBAO_ENDPOINT"],
            additional_headers=headers,
            max_size=None,
            open_timeout=timeout,
            close_timeout=5,
        )
    except InvalidStatus as exc:
        raise explain_handshake_error(exc) from None
    with ws:
        try:
            dbg("logid", ws.response.headers.get("X-Tt-Logid"))
        except Exception:
            pass

        ws.send(frame(CLIENT_FULL_REQUEST, POS_SEQUENCE,
                      json.dumps(build_request()).encode("utf-8"), seq=1))
        msg_type, _, payload = parse_frame(ws.recv(timeout=timeout))
        dbg("handshake ->", msg_type, payload)
        if msg_type == SERVER_ERROR:
            raise RuntimeError(f"豆包握手失败: {payload}")

        seq = 1
        for i, chunk in enumerate(chunks):
            seq += 1
            last = i == len(chunks) - 1
            ws.send(frame(
                CLIENT_AUDIO_ONLY,
                NEG_WITH_SEQUENCE if last else POS_SEQUENCE,
                chunk,
                seq=-seq if last else seq,
                serial=NO_SERIALIZATION,
            ))

        while True:
            msg_type, flags, payload = parse_frame(ws.recv(timeout=timeout))
            dbg("recv ->", msg_type, flags, payload)
            if msg_type == SERVER_ERROR:
                raise RuntimeError(f"豆包识别失败: {payload}")
            got = extract_text(payload)
            if got:
                text = got
            if flags & 0x02:  # last packet from server
                break
    return text.strip()


# ------------------------------------------------------------ http front ----

def to_pcm16k(audio: bytes) -> bytes:
    """Whatever voxtype uploaded -> raw 16k mono s16le, via ffmpeg."""
    proc = subprocess.run(
        ["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", "pipe:0",
         "-f", "s16le", "-acodec", "pcm_s16le", "-ac", "1", "-ar", "16000", "pipe:1"],
        input=audio, capture_output=True,
    )
    if proc.returncode != 0 or not proc.stdout:
        raise RuntimeError(f"ffmpeg 转码失败: {proc.stderr.decode('utf-8', 'replace')[:400]}")
    return proc.stdout


def parse_multipart(body: bytes, content_type: str) -> dict:
    m = re.search(r'boundary=(?:"([^"]+)"|([^;]+))', content_type)
    if not m:
        return {}
    boundary = (m.group(1) or m.group(2)).strip().encode()
    fields = {}
    for part in body.split(b"--" + boundary):
        if part.startswith(b"--") or not part.strip():
            continue
        part = part[2:] if part.startswith(b"\r\n") else part
        head, sep, data = part.partition(b"\r\n\r\n")
        if not sep:
            continue
        if data.endswith(b"\r\n"):
            data = data[:-2]
        name = re.search(r'name="([^"]*)"', head.decode("utf-8", "replace"))
        if name:
            fields[name.group(1)] = data
    return fields


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        dbg("http", fmt % args)

    def _json(self, status, obj):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.rstrip("/") in ("/health", "/healthz"):
            self._json(200, {"status": "ok", "endpoint": CFG["DOUBAO_ENDPOINT"]})
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        # Accept whatever path the client uses -- OpenAI clients hit
        # /v1/audio/transcriptions, whisper.cpp servers hit /inference.
        # Anything carrying a multipart file is treated as a transcription.
        dbg("POST", self.path)
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length)
        fields = parse_multipart(body, self.headers.get("Content-Type", ""))
        audio = fields.get("file")
        if not audio:
            self._json(400, {"error": {"message": "missing file field"}})
            return
        try:
            text = transcribe(to_pcm16k(audio))
        except Exception as exc:  # surfaced to voxtype as a failed transcription
            log(f"error: {exc}")
            self._json(500, {"error": {"message": str(exc)}})
            return
        # Dictated text stays out of the journal unless debugging.
        log(f"ok: {len(audio)} bytes -> {len(text)} chars")
        dbg("text", repr(text))
        self._json(200, {"text": text})


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--selftest":
        if len(sys.argv) < 3:
            log("用法: voxtype-doubao-shim --selftest <音频文件>")
            return 2
        try:
            with open(sys.argv[2], "rb") as fh:
                text = transcribe(to_pcm16k(fh.read()))
        except Exception as exc:
            log(f"失败: {exc}")
            return 1
        if text:
            print(text)
        else:
            log("鉴权和连接正常，但这段音频里没识别出文字（静音或纯音时属正常）")
        return 0

    host, port = CFG["SHIM_HOST"], int(CFG["SHIM_PORT"])
    log(f"voxtype-doubao-shim listening on http://{host}:{port} "
        f"-> {CFG['DOUBAO_ENDPOINT']}")
    ThreadingHTTPServer((host, port), Handler).serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
