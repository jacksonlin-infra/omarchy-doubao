# 豆包（火山引擎）流式语音识别 凭据与参数
# 位置：~/.config/doubao-dictate/doubao.env，权限 600。install.sh 会自动生成。
# 改完执行 systemctl --user restart doubao-dictate 生效。
#
# 凭据二选一：
#   新版控制台（2025 年后新开的账号基本都是这种）：只填 DOUBAO_API_KEY
#     https://console.volcengine.com/speech/new/setting/apikeys
#   旧版控制台：填 DOUBAO_APP_ID + DOUBAO_ACCESS_TOKEN
#     控制台 → 语音技术 → 应用管理，复制 App ID 与 Access Token
# 两种都填时优先用 API Key。
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=

# 资源 ID 必须和控制台开通的模型版本对上，前缀错了建连直接被拒：
#   豆包流式语音识别模型2.0：按时长 volc.seedasr.sauc.duration / 并发版 volc.seedasr.sauc.concurrent
#   豆包流式语音识别模型1.0：按时长 volc.bigasr.sauc.duration  / 并发版 volc.bigasr.sauc.concurrent
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration

# bigmodel_async = 双向流式优化版：说话时实时出字，松开后用非流式模型把整段再识别一遍（二遍识别），
# 最终结果和整段识别一样准。不要改成 .../sauc/bigmodel：模型2.0 的按时长资源在那个端点上会报
# 400 "resourceId volc.seedasr.sauc.duration is not allowed"
DOUBAO_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# ITN：把“二零二五年”写成“2025年”；PUNC：自动标点；DDC：语义顺滑
DOUBAO_ENABLE_ITN=1
DOUBAO_ENABLE_PUNC=1
DOUBAO_ENABLE_DDC=1
# 松开后等最终结果的秒数，超时就用最后一次的实时结果
DOUBAO_TIMEOUT=10

# 单次录音上限（秒），到点自动结束
DICTATE_MAX_SECS=300
# 麦克风：空 = 系统默认；要指定就填 pw-record --target 认的节点名（wpctl status 里看）
DICTATE_AUDIO_DEVICE=
# paste = 经剪贴板粘贴到光标处（终端发 Shift+Insert，其他程序发 Ctrl+V；之后还原原来的剪贴板文字）
# type = 用 wtype 逐字输入（开着 fcitx5 等输入法时中文会丢字，不推荐）
# clipboard = 只复制到剪贴板，自己粘贴；none = 只写日志
DICTATE_OUTPUT=paste
# 悬浮条离屏幕底边的距离、宽度（逻辑像素）
DICTATE_BOTTOM_MARGIN=72
DICTATE_WIDTH=640

# 排障时改成 1，然后 journalctl --user -u doubao-dictate -f（会把识别出的文字写进日志）
DOUBAO_DEBUG=0
