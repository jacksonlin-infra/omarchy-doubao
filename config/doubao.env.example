# 豆包（火山引擎）流式语音识别 凭据
# 复制到 ~/.config/voxtype/doubao.env 并 chmod 600。install.sh 会自动做这一步。
#
# 凭据二选一：
#   新版控制台（2025 年后新开的账号基本都是这种）：只填 DOUBAO_API_KEY
#     https://console.volcengine.com/speech/new/setting/apikeys
#   旧版控制台：填 DOUBAO_APP_ID + DOUBAO_ACCESS_TOKEN
#     控制台 → 语音技术 → 应用管理，复制 App ID 与 Access Token
# 两种都填时优先用 API Key。
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=

# 资源 ID 必须和控制台开通的模型版本对上，前缀错了建连直接被拒：
#   豆包流式语音识别模型2.0：按时长 volc.seedasr.sauc.duration / 并发版 volc.seedasr.sauc.concurrent
#   豆包流式语音识别模型1.0：按时长 volc.bigasr.sauc.duration  / 并发版 volc.bigasr.sauc.concurrent
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration

# nostream = 流式输入、说完一次性返回，官方说明准确率高于双向流式，适合按住说话。
# 不要改成 .../sauc/bigmodel（双向流式），模型2.0 的按时长资源在那个端点上会报
# 400 "resourceId volc.seedasr.sauc.duration is not allowed"
DOUBAO_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream

# ITN：把“二零二五年”写成“2025年”；PUNC：自动标点；DDC：去掉“嗯”“那个”这类口水词
DOUBAO_ENABLE_ITN=1
DOUBAO_ENABLE_PUNC=1
DOUBAO_ENABLE_DDC=1
DOUBAO_TIMEOUT=20

# 本地转接服务监听地址，必须和 ~/.config/voxtype/config.toml 里的 remote_endpoint 一致
SHIM_HOST=127.0.0.1
SHIM_PORT=6688

# 排障时改成 1，然后 journalctl --user -u voxtype-doubao -f（会把识别出的文字写进日志）
DOUBAO_DEBUG=0
